{
  "name": "@arraypress/waveform-sounds-vue",
  "version": "0.1.0",
  "description": "Vue 3 component wrapper for @arraypress/waveform-sounds — a searchable, filterable sound list with typed props for every option, lifecycle emits, an exposed imperative API, and server-rendered markup the runtime adopts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "audio",
    "waveform",
    "samples",
    "sample-pack",
    "sound-browser",
    "preview",
    "presets",
    "player",
    "filter",
    "search"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/waveform-sounds-vue.git"
  },
  "bugs": {
    "url": "https://github.com/arraypress/waveform-sounds-vue/issues"
  },
  "homepage": "https://waveformplayer.com",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/arraypress"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@arraypress/waveform-player": "^1.24.5",
    "@arraypress/waveform-sounds": "^0.1.0",
    "vue": "^3.5.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arraypress/waveform-player": "^1.29.1",
    "@arraypress/waveform-sounds": "^0.1.0",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  }
}
